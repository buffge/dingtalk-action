  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --target=node24 --tree-shaking=true --legal-comments=none --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
